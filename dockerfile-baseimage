# litellm[proxy,extra_proxy]==1.93.0 설치 + prisma 클라이언트 생성을 담당하는 base image.
# pyproject.toml(gateway-cloudrun 쪽 오프라인 점검용 프로젝트)의 litellm 핀과 반드시 동일해야 한다
# (패치가 어댑터 내부 시그니처에 의존 — 버전 스큐 시 몽키패치가 조용히 빗나간다).
FROM asia-northeast3-docker.pkg.dev/pjt-prd-lgcaip-cicd/ar-prd-lgcaip-cicd-runner/python:3.12.11 AS builder

USER root
# 기본 apt 소스(mirror.kakao.com)가 사내망에서 응답하지 않아 deb.debian.org로 교체(실측 확인).
# nodejs/npm은 prisma CLI(엔진 바이너리 디스패치용 Node 래퍼) 구동에 필요 — pip 설치만으론 부족하다.
RUN sed -i 's#mirror.kakao.com#deb.debian.org#' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs npm && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
# --target=이 아니라 --prefix=를 쓴다: --target=은 라이브러리 파일만 깔고 console_script(엔트리포인트
# 실행 파일)를 만들지 않는데, prisma generate가 내부적으로 `prisma-client-py` 실행 파일을 PATH에서
# 찾아 호출한다(generator client 블록) — --prefix=라야 bin/에 그 실행 파일이 같이 생긴다.
RUN pip install --upgrade --no-cache-dir -r requirements.txt --prefix=/home/appuser/packages

# binaries.prisma.sh가 사내망에서 전면 차단되어 있어(실측 확인) prisma 엔진 바이너리를 리포에
# vendoring해서 쓴다. PRISMA_*_ENGINE_BINARY로 경로를 직접 지정하면 prisma CLI가 자체 다운로드를
# 건너뛴다 — 빌드 시점(generate)과 기동 시점(migrate deploy) 양쪽 다 필요해 최종 스테이지에도 넘긴다.
COPY vendor/prisma-engines/schema-engine.gz vendor/prisma-engines/query-engine.gz /home/appuser/prisma-engines/
RUN gunzip -f /home/appuser/prisma-engines/schema-engine.gz && \
    gunzip -f /home/appuser/prisma-engines/query-engine.gz && \
    chmod +x /home/appuser/prisma-engines/schema-engine /home/appuser/prisma-engines/query-engine

ENV HOME=/home/appuser
ENV PYTHONPATH=/home/appuser/packages/lib/python3.12/site-packages
ENV PATH=/home/appuser/packages/bin:$PATH
ENV PRISMA_SCHEMA_ENGINE_BINARY=/home/appuser/prisma-engines/schema-engine
ENV PRISMA_QUERY_ENGINE_BINARY=/home/appuser/prisma-engines/query-engine
RUN python3 -m prisma generate --schema=/home/appuser/packages/lib/python3.12/site-packages/litellm/proxy/schema.prisma && \
    chown -R appuser:appuser /home/appuser

FROM asia-northeast3-docker.pkg.dev/pjt-prd-lgcaip-cicd/ar-prd-lgcaip-cicd-runner/python:3.12.11
USER root
RUN sed -i 's#mirror.kakao.com#deb.debian.org#' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs npm && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /home/appuser/packages /app/python_packages/
COPY --from=builder /home/appuser/.cache /home/appuser/.cache
COPY --from=builder /home/appuser/prisma-engines /home/appuser/prisma-engines
RUN chown -R appuser:appuser /app/python_packages /home/appuser/.cache /home/appuser/prisma-engines

USER appuser
ENV HOME=/home/appuser
ENV PYTHONPATH=/app/python_packages/lib/python3.12/site-packages
ENV PATH=/app/python_packages/bin:$PATH
ENV PRISMA_SCHEMA_ENGINE_BINARY=/home/appuser/prisma-engines/schema-engine
ENV PRISMA_QUERY_ENGINE_BINARY=/home/appuser/prisma-engines/query-engine
WORKDIR /app
